rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is active (not suspended or pending deletion)
    // Task #76: Block access for soft-deleted users
    function isActiveUser() {
      return request.auth != null &&
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              (
                (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended') &&
                (!('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus != 'pending_deletion')
              ));
    }

    // Users collection
    match /users/{userId} {
      // Admins can read and write all user documents
      allow read, write: if isAdmin();

      // Owner can read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Owner can create their own doc, but cannot self-assign a privileged role.
      // (Normal registration goes through the registerUser Cloud Function / admin SDK.)
      allow create: if request.auth != null && request.auth.uid == userId &&
                    request.resource.data.get('role', 'user') == 'user';

      // Owner can update their own doc (e.g. fcmToken) but CANNOT change privileged
      // fields. role / status / accountStatus are admin-controlled only. Because
      // update rules see the post-merge document, unchanged fields are preserved.
      allow update: if request.auth != null && request.auth.uid == userId &&
                    request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
                    request.resource.data.get('status', '') == resource.data.get('status', '') &&
                    request.resource.data.get('accountStatus', '') == resource.data.get('accountStatus', '');

      // Account deletion is handled by Cloud Functions (admin SDK bypasses rules).
      allow delete: if isAdmin();
    }

    // Vehicles collection: Authenticated users can read, owners/admins can manage
    match /vehicles/{vehicleId} {
      // Public Read Access (Field-Level Security):
      // - All authenticated users can read APPROVED vehicles
      // - Vehicle owners can read their own vehicles (any status)
      // - Admins can read all vehicles (any status)
      // NOTE: Firestore doesn't support field-level filtering in rules.
      //       Sensitive fields (sellerId, currentOwnerId, sellerPhone) should be
      //       filtered client-side for non-owners/non-admins.
      allow read: if request.auth != null && (
        // Public users can see exposed vehicles (거래 단계 기준)
        resource.data.status == 'approved' ||
        resource.data.get('dealStage', '') in ['listed', 'acquiring', 'in_stock'] ||
        // Vehicle owner can see their own vehicle (any status)
        request.auth.uid == resource.data.get('currentOwnerId', resource.data.sellerId) ||
        // Admins can see all vehicles
        isAdmin()
      );

      // 자동노출 정책: 사용자가 등록 즉시 노출되는 매물을 만들 수 있다.
      // dealStage는 'listed'로만 시작 가능하고, 매입/판매/관리자소유 같은 권한
      // 필드는 자가설정 불가(아래 조건으로 차단). 품질은 사후 모더레이션으로 통제.
      allow create: if request.auth != null &&
                    isActiveUser() &&
                    request.auth.uid == request.resource.data.sellerId &&
                    request.resource.data.status == 'approved' &&
                    request.resource.data.get('dealStage', '') == 'listed' &&
                    request.resource.data.get('isAdminOwned', false) == false &&
                    request.resource.data.get('currentOwnerId', request.auth.uid) == request.auth.uid &&
                    request.resource.data.vehicleId is string &&
                    request.resource.data.vehicleName is string &&
                    request.resource.data.manufacturer is string &&
                    request.resource.data.sellerId is string;

      // Vehicle update rules (Task 54 - Ownership Transfer):
      // 1. Admin can update any field
      // 2. Current owner (currentOwnerId or legacy sellerId) can update EXCEPT critical ownership fields
      allow update: if request.auth != null &&
                    isActiveUser() &&
                    (
                      // Admin can update everything
                      isAdmin() ||
                      // Current owner can update non-critical fields
                      (
                        (request.auth.uid == resource.data.get('currentOwnerId', resource.data.sellerId)) &&
                        // Prevent owner from changing ownership fields
                        (!('currentOwnerId' in request.resource.data) || request.resource.data.currentOwnerId == resource.data.get('currentOwnerId', null)) &&
                        (!('isAdminOwned' in request.resource.data) || request.resource.data.isAdminOwned == resource.data.get('isAdminOwned', false)) &&
                        (!('ownershipHistory' in request.resource.data) || request.resource.data.ownershipHistory == resource.data.get('ownershipHistory', [])) &&
                        // Prevent owner from changing approval/sold status (admin-only)
                        (request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')) &&
                        // Prevent owner from tampering with the deal stage (admin/buyer-flow only)
                        (request.resource.data.get('dealStage', '') == resource.data.get('dealStage', ''))
                      ) ||
                      // Buyer-initiated stage transition: any active authenticated user may
                      // move a LISTED vehicle to ACQUIRING when requesting a buy consultation.
                      // Nothing else may change — sensitive fields are frozen.
                      (
                        resource.data.get('dealStage', '') == 'listed' &&
                        request.resource.data.dealStage == 'acquiring' &&
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.get('currentOwnerId', null) == resource.data.get('currentOwnerId', null) &&
                        request.resource.data.get('isAdminOwned', false) == resource.data.get('isAdminOwned', false) &&
                        request.resource.data.get('price', 0) == resource.data.get('price', 0) &&
                        request.resource.data.get('sellerId', '') == resource.data.get('sellerId', '') &&
                        (!('ownershipHistory' in request.resource.data) || request.resource.data.ownershipHistory == resource.data.get('ownershipHistory', []))
                      )
                    );

      // Vehicle owner or active admin can delete vehicles
      allow delete: if request.auth != null &&
                    isActiveUser() &&
                    ((request.auth.uid == resource.data.get('currentOwnerId', resource.data.sellerId)) || isAdmin());

      // Private contact subdocument (Task 125): seller PII kept OUT of the public
      // vehicle doc so it cannot be scraped by other authenticated users.
      // The doc stores its own sellerId so authorization needs no parent get()
      // (which would race during a batched create of vehicle + private doc).
      match /private/{docId} {
        allow read: if isAdmin() ||
                    (request.auth != null &&
                     request.auth.uid == resource.data.get('sellerId', ''));
        // Owner creates their own contact doc at registration time
        allow create: if isAdmin() ||
                      (request.auth != null &&
                       isActiveUser() &&
                       request.auth.uid == request.resource.data.get('sellerId', ''));
        // Edits/cleanup are admin-only (migration, account deletion via admin SDK)
        allow update, delete: if isAdmin();
      }
    }

    // Consultation requests collection: Only active users can create, admins have full access
    // Fields: userId, vehicleId, preferredDate, preferredTime, type, consultationStatus, createdAt
    // Admin-only fields: rejectionReason, adminMemo, alternativeSlots
    // Task 47 fields: isOwnershipTransferred, transferId, dealAmount
    match /consultation_requests/{requestId} {
      // Read access (Task 54):
      // 1. User who created the request (userId)
      // 2. Vehicle seller/owner (if type is 'sell')
      // 3. Admins
      allow read: if request.auth != null &&
        (
          request.auth.uid == resource.data.userId ||
          (resource.data.type == 'sell' && request.auth.uid == resource.data.get('sellerId', '')) ||
          isAdmin()
        );

      // Only active users can create requests for themselves
      allow create: if request.auth != null &&
        isActiveUser() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.consultationStatus == 'pending';

      // Update rules (Task 54 - Enhanced):
      // 1. Admins can update any field (including ownership transfer fields)
      // 2. Users can cancel their own consultation
      // 3. Users can resubmit rejected consultations
      // 4. Ownership transfer fields (isOwnershipTransferred, transferId, dealAmount) are admin-only
      allow update: if (isAdmin() && isActiveUser()) ||
                      // User cancellation (only before approval)
                      (request.auth != null &&
                       isActiveUser() &&
                       request.auth.uid == resource.data.userId &&
                       request.resource.data.consultationStatus == 'cancelled' &&
                       (resource.data.consultationStatus == 'pending' ||
                        resource.data.consultationStatus == 'confirmed' ||
                        resource.data.consultationStatus == 'on-hold') &&
                       // Validate serverTimestamp is used for cancelledAt
                       request.resource.data.cancelledAt == request.time &&
                       // Ensure core fields are not modified (only if they exist in original)
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.vehicleId == resource.data.vehicleId &&
                       request.resource.data.type == resource.data.type &&
                       // Ensure user cannot set ownership transfer fields
                       (!('isOwnershipTransferred' in request.resource.data) || request.resource.data.isOwnershipTransferred == resource.data.get('isOwnershipTransferred', false)) &&
                       !('transferId' in request.resource.data) &&
                       !('dealAmount' in request.resource.data)) ||
                      // User resubmission of rejected consultation
                      // Allow users to resubmit with new date/time and remove admin-only fields
                      (request.auth != null &&
                       isActiveUser() &&
                       request.auth.uid == resource.data.userId &&
                       resource.data.consultationStatus == 'rejected' &&
                       request.resource.data.consultationStatus == 'pending' &&
                       request.resource.data.preferredDate is string &&
                       request.resource.data.preferredTime is string &&
                       // Explicitly allow deletion of admin-only fields
                       !('rejectionReason' in request.resource.data) &&
                       !('alternativeSlots' in request.resource.data) &&
                       !('rejectedAt' in request.resource.data));

      // Only active admins can delete requests
      allow delete: if isAdmin() && isActiveUser();
    }

    // Consultation slots: 이중예약 방지용 슬롯 선점 문서 (PII 없음).
    // 문서 ID = {vehicleId}_{date}_{time}. create-only 정책이 원자적 선점을 보장한다:
    // 이미 존재하는 슬롯에 대한 set은 update로 취급되어 거부되고,
    // 슬롯을 포함한 배치 커밋 전체가 실패한다 (consultationSlotService.js 참고).
    match /consultation_slots/{slotId} {
      // 인증 사용자는 슬롯 점유 여부를 조회할 수 있다(시간 점유 사실만 노출)
      allow read: if request.auth != null;

      // 본인 명의로만 선점 가능
      allow create: if request.auth != null &&
                    isActiveUser() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.vehicleId is string &&
                    request.resource.data.preferredDate is string &&
                    request.resource.data.preferredTime is string;

      // 점유된 슬롯은 변경 불가(선점의 원자성 근거)
      allow update: if false;

      // 해제: 관리자(거절/일정변경) 또는 슬롯 소유자(취소/재신청)
      allow delete: if isAdmin() ||
                    (request.auth != null && request.auth.uid == resource.data.userId);
    }

    // Admin activity log collection: Only admins can write, no one can delete
    match /admin_activity_log/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // Only active admins can create logs
      allow create: if isAdmin() && isActiveUser();

      // No one can update or delete logs
      allow update, delete: if false;
    }

    // Admin owned vehicles collection: Only admins can access
    match /admin_owned_vehicles/{vehicleId} {
      // Only admins can read owned vehicles
      allow read: if isAdmin();

      // Only active admins can create owned vehicles
      allow create: if isAdmin() && isActiveUser();

      // Only active admins can update owned vehicles
      allow update: if isAdmin() && isActiveUser();

      // Only active admins can delete owned vehicles
      allow delete: if isAdmin() && isActiveUser();
    }

    // Ownership transfers collection (Task 47, 54): Immutable admin-only records
    match /ownership_transfers/{transferId} {
      // Only admins can read ownership transfer records
      allow read: if isAdmin();

      // Only active admins can create ownership transfer records
      // Validates all required fields are present
      allow create: if isAdmin() &&
                    isActiveUser() &&
                    request.resource.data.transferId is string &&
                    request.resource.data.vehicleId is string &&
                    request.resource.data.transferType in ['sell_to_admin', 'admin_to_buyer'] &&
                    request.resource.data.transferredAt is timestamp &&
                    request.resource.data.price is number &&
                    request.resource.data.price >= 0;

      // NO ONE can update or delete ownership transfer records (immutable audit log)
      allow update, delete: if false;
    }

    // Ownership transfer audit logs collection (Task 60): Comprehensive monitoring logs
    match /ownership_transfer_audit_logs/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();

      // Only active admins can create audit log entries
      // These are created automatically by ownershipTransferService
      allow create: if isAdmin() &&
                    isActiveUser() &&
                    request.resource.data.transferType in ['sell_to_admin', 'admin_to_buyer'] &&
                    request.resource.data.vehicleId is string &&
                    request.resource.data.consultationId is string &&
                    request.resource.data.status in ['completed', 'failed'] &&
                    request.resource.data.duration is number &&
                    request.resource.data.timestamp is timestamp;

      // NO ONE can update or delete audit logs (immutable for compliance)
      allow update, delete: if false;
    }

    // Consultation rate limits collection (Task 82): Tracks request rates per user
    match /consultation_rate_limits/{userId} {
      // Only the user themselves can read their rate limit data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Only Cloud Functions (with admin privileges) can write rate limit data
      // Users should not be able to modify their own rate limits
      allow write: if false;
    }

    // Default deny-all policy for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
