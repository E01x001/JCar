# Android Gradle Properties Example
# Copy this file to gradle.properties and fill in your actual values
# DO NOT commit gradle.properties to version control

# Keystore Configuration for Release Builds
MYAPP_UPLOAD_STORE_FILE=jcar-upload-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=jcar-key-alias
MYAPP_UPLOAD_STORE_PASSWORD=your_keystore_password_here
MYAPP_UPLOAD_KEY_PASSWORD=your_key_password_here

# React Native Configuration
org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m
android.useAndroidX=true
android.enableJetifier=true

# Build Performance
org.gradle.parallel=true
org.gradle.configureondemand=true
org.gradle.caching=true
